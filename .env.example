# SUNGRAZER AI — local configuration template.
# Copy to .env and adjust. Only variables the code actually reads are listed;
# new variables are added here as the features that use them land.

# Root directory for downloaded/processed data (default: ./data)
SOHO_DATA_ROOT=./data

# LASCO level-0.5 archives (defaults are the verified public archives)
LASCO_HISTORICAL_BASE_URL=https://lasco-www.nrl.navy.mil/lz/level_05
LASCO_RECENT_BASE_URL=https://umbra.nascom.nasa.gov/pub/lasco/lastimage/level_05
LASCO_HTTP_TIMEOUT_SECONDS=60
LASCO_DOWNLOAD_RETRIES=3

LOG_LEVEL=INFO
